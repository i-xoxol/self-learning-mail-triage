# Documentation template: the application reads environment variables, not this file.
OUTLOOK_GRAPH_CLIENT_ID=YOUR_ENTRA_PUBLIC_CLIENT_APPLICATION_ID
OUTLOOK_GRAPH_AUTHORITY=https://login.microsoftonline.com/organizations
# Runtime files default to ~/.local/share/mail-triage and ~/.config/mail-triage.
# Use absolute paths if you override them; keep them outside the checkout.
# OUTLOOK_MSAL_CACHE=/absolute/private/msal-cache.json
# OUTLOOK_PLAYBOOK_DB=/absolute/private/playbook.sqlite3
# OUTLOOK_PROFILE_FILE=/absolute/private/profile.toml
OUTLOOK_AUTO_LEARN_STYLE=0
OUTLOOK_CASE_MEMORY_ENABLED=1
OUTLOOK_CASE_RETENTION_DAYS=365
OUTLOOK_MCP_TRANSPORT=stdio
# Remote only: HTTPS reverse proxy, OAuth pairing, and separate private database.
# OUTLOOK_MCP_TRANSPORT=streamable-http
# OUTLOOK_MCP_PUBLIC_BASE_URL=https://mail-triage.example.com
# OUTLOOK_MCP_OAUTH_DB=/absolute/private/oauth.sqlite3
OUTLOOK_MCP_HTTP_HOST=127.0.0.1
OUTLOOK_MCP_HTTP_PORT=8765
